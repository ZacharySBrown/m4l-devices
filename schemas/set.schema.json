{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "setforge/set.schema.json",
  "title": "Setforge set.json (schema_version 1.0)",
  "type": "object",
  "required": ["schema_version", "name", "global_tempo", "preset_bank_A", "preset_bank_B"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "1.0" },
    "name": { "type": "string", "minLength": 1 },
    "global_tempo": { "type": "number", "exclusiveMinimum": 0 },
    "preset_bank_A": { "$ref": "#/$defs/bank" },
    "preset_bank_B": { "$ref": "#/$defs/bank" },
    "setlist": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "bank": {
      "type": "array",
      "description": "8 preset slots; a slot may be null when empty.",
      "items": {
        "anyOf": [
          { "type": "null" },
          {
            "type": "object",
            "required": ["track_id"],
            "additionalProperties": true,
            "properties": {
              "track_id": { "type": "string" },
              "scenes": { "type": "array" }
            }
          }
        ]
      }
    }
  }
}

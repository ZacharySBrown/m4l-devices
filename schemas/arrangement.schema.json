{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "setforge/arrangement.schema.json",
  "title": "Setforge arrangement_manifest.json (schema_version 1)",
  "type": "object",
  "required": ["schema_version", "bpm", "chunks"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "bpm": { "type": "number", "exclusiveMinimum": 0 },
    "first_downbeat_sec": { "type": "number" },
    "forge_slug": { "type": "string" },
    "manifest_hash": { "type": "string" },
    "source_audio": { "type": "string" },
    "chunks": { "type": "array", "items": { "$ref": "#/$defs/chunk" } },
    "placements": { "type": "array", "items": { "$ref": "#/$defs/placement" } },
    "scene_markers": { "type": "array", "items": { "$ref": "#/$defs/scene_marker" } }
  },
  "$defs": {
    "chunk": {
      "type": "object",
      "required": ["audio_path", "bar_position", "stem"],
      "additionalProperties": true,
      "properties": {
        "audio_path": { "type": "string" },
        "bar_position": { "type": "integer", "minimum": 0 },
        "chunk_id": { "type": "string" },
        "duration_bars": { "type": ["integer", "number"] },
        "duration_sec": { "type": "number" },
        "source_position_sec": { "type": "number" },
        "stem": { "type": "string" }
      }
    },
    "placement": {
      "type": "object",
      "required": ["deck", "stem", "start_bar", "len_bars"],
      "additionalProperties": true,
      "properties": {
        "deck": { "type": "string", "enum": ["A", "B"] },
        "stem": { "type": "string" },
        "clip_id": { "type": "string" },
        "start_bar": { "type": "number", "minimum": 0 },
        "len_bars": { "type": "number", "exclusiveMinimum": 0 },
        "source": { "type": "string" },
        "color": { "type": ["string", "null"] }
      }
    },
    "scene_marker": {
      "type": "object",
      "required": ["scene_id", "start_bar"],
      "additionalProperties": true,
      "properties": {
        "scene_id": { "type": "string" },
        "name": { "type": "string" },
        "color": { "type": ["string", "null"] },
        "start_bar": { "type": "number", "minimum": 0 }
      }
    }
  }
}
